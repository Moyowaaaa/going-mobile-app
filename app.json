{
  "expo": {
    "name": "going-web",
    "slug": "going-web",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goingweb",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "PlusJakartaSans",
                "fontDefinitions": [
                  { "path": "./assets/fonts/PlusJakartaSans-Variable.ttf", "weight": 400 },
                  { "path": "./assets/fonts/PlusJakartaSans-Variable.ttf", "weight": 500 },
                  { "path": "./assets/fonts/PlusJakartaSans-Variable.ttf", "weight": 600 },
                  { "path": "./assets/fonts/PlusJakartaSans-Variable.ttf", "weight": 700 },
                  { "path": "./assets/fonts/PlusJakartaSans-Variable.ttf", "weight": 800 },
                  {
                    "path": "./assets/fonts/PlusJakartaSans-VariableItalic.ttf",
                    "weight": 400,
                    "style": "italic"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/PlusJakartaSans-Variable.ttf",
              "./assets/fonts/PlusJakartaSans-VariableItalic.ttf"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow going to use your photos for event banners.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
